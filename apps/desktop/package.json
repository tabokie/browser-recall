{
  "name": "@browser-recall/desktop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:release": "node ../../scripts/build-release-desktop.mjs",
    "build:ui": "node ../../scripts/stage-app-assets.mjs desktop-ui",
    "build:app-store": "npm run build:ui && node ../../scripts/build-tauri-app.mjs build --bundles app --features mac-app-store",
    "dev": "node ../../scripts/dev-desktop.mjs",
    "build": "node ../../scripts/build-desktop.mjs",
    "build:unsigned": "node ../../scripts/build-desktop.mjs unsigned",
    "build:signed": "node ../../scripts/build-desktop.mjs signed",
    "verify:macos-bundle": "node ../../scripts/verify-macos-app-bundle.mjs '../../dist/desktop/macos/app/Browser Recall.app'",
    "build:dmg": "node ../../scripts/build-desktop.mjs dmg"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "dependencies": {
    "justif": "^0.6.5"
  }
}
