{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Recall",
  "version": "1.0.1",
  "identifier": "app.browser-recall.desktop",
  "build": {
    "frontendDist": "../../../dist/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Browser Recall",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["browser-recall"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4OUM2NkM3MTQ5QTk1NkMKUldSc2xab1V4MmFjeUV5RGQ4MDlRbW9Sd2JkVDJueldGTFE4anJwaVdiQTlpNEpCNjgrZzQzYloK",
      "endpoints": [
        "https://github.com/tabokie/browser-recall/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
