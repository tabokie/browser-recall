{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Recall",
  "version": "0.1.0",
  "identifier": "app.browser-recall.desktop",
  "build": {
    "frontendDist": "../../../dist/desktop-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Browser Recall",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["browser-recall"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
