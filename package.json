{
  "name": "portal-extension",
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension for tracking and searching browsing history",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir extension/pkg",
    "build": "npm run build:wasm",
    "watch": "wasm-pack build --target web --out-dir extension/pkg --dev",
    "dev": "npm run watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manual": "node scripts/manual-test-browser.mjs",
    "manual:seed": "node scripts/manual-test-browser.mjs --seed",
    "manual:case": "node scripts/manual-test-browser.mjs --case"
  },
  "keywords": [
    "chrome-extension",
    "rust",
    "wasm",
    "knowledge-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@playwright/test": "^1.58.2",
    "flexsearch": "^0.8.212",
    "jsdom": "^28.0.0",
    "minisearch": "^7.2.0",
    "vitest": "^3.0.0"
  }
}
