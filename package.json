{
  "name": "browser-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.11.0",
  "description": "Chrome extension for tracking and searching browsing history",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:extension && npm run build --workspace @browser-recall/desktop",
    "build:extension": "node scripts/stage-app-assets.mjs extension",
    "build:desktop-ui": "node scripts/stage-app-assets.mjs desktop-ui",
    "locales:check": "node scripts/stage-app-assets.mjs locales",
    "watch": "node -e \"console.log('No root watch step is required for the extension')\"",
    "dev": "npm run build:extension && node -e \"console.log('Load dist/extension/chrome in Chrome, or run npm run dev:desktop for the Tauri shell')\"",
    "dev:desktop": "npm run dev --workspace @browser-recall/desktop",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:firefox:smoke": "playwright test --config playwright.smoke.config.js tests/smoke/firefox-extension.spec.js",
    "test:visual": "npm run build:desktop-ui && playwright test tests/e2e/desktop-visual.spec.js",
    "test:desktop-native": "npm run build --workspace @browser-recall/desktop && node tests/smoke/macos-desktop-window-lifecycle.mjs",
    "coverage": "npm run coverage:js && npm run coverage:rust && npm run coverage:monitor",
    "coverage:js": "vitest run --config vitest.coverage.config.js --coverage",
    "coverage:rust": "node scripts/rust-coverage.mjs",
    "coverage:monitor": "node scripts/test-coverage-monitor.mjs",
    "manual": "node scripts/manual-test-browser.mjs",
    "manual:seed": "node scripts/manual-test-browser.mjs --seed",
    "manual:case": "node scripts/manual-test-browser.mjs --case",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint:unused": "knip --include files,exports,duplicates",
    "lint:duplicates": "jscpd apps/extension/ --min-lines 5 --min-tokens 50"
  },
  "keywords": [
    "chrome-extension",
    "rust",
    "knowledge-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^3.0.0",
    "jscpd": "5.0.11",
    "jsdom": "^28.0.0",
    "knip": "6.23.0",
    "prettier": "^3.8.2",
    "vitest": "^3.0.0",
    "ws": "^8.18.1"
  }
}
