{
  "name": "portal-extension",
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension for tracking and searching interaction history",
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir extension/pkg",
    "vendor": "mkdir -p extension/vendor && cp node_modules/@huggingface/transformers/dist/transformers.min.js node_modules/@huggingface/transformers/dist/ort-wasm-simd-threaded.jsep.mjs extension/vendor/",
    "build": "npm run build:wasm && npm run vendor",
    "watch": "wasm-pack build --target web --out-dir extension/pkg --dev",
    "dev": "npm run watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "chrome-extension",
    "rust",
    "wasm",
    "knowledge-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@playwright/test": "^1.58.2",
    "jsdom": "^28.0.0",
    "vitest": "^3.0.0"
  }
}
