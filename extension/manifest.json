{
  "manifest_version": 3,
  "name": "browser-recall",
  "version": "1.0",
  "description": "Save your browsing history, notes, and highlights to a local folder you control.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "history",
    "offscreen",
    "scripting",
    "webNavigation",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["savepage/content-fontface.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["savepage/content-fontface-intercept.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-snapshot": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Capture snapshot of current page"
    },
    "highlight-selection": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Highlight selected text"
    },
    "like-page": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Like the current page"
    },
    "dislike-page": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Dislike the current page"
    }
  },
  "sandbox": {
    "pages": ["smart-rule-sandbox.html"]
  }
}
